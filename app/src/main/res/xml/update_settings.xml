<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_updates_title">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/update_app_key"
        android:summary="@string/updates_setting_description"
        android:title="@string/updates_setting_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/manual_update_key"
        android:summary="@string/manual_update_description"
        android:title="@string/manual_update_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:key="@string/newpipet_channel_key"
        android:title="@string/newpipet_channel_title"
        android:defaultValue="stable"
        android:entries="@array/newpipet_channels"
        android:entryValues="@array/newpipet_channel_values"
        app:useSimpleSummaryProvider="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="@string/newpipet_policy_key"
        android:title="@string/newpipet_policy_title"
        android:summary="@string/newpipet_policy_summary"
        android:defaultValue="false"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/newpipet_diagnostics_key"
        android:title="@string/newpipet_diagnostics_title"
        android:summary="@string/newpipet_diagnostics_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/newpipet_clear_cache_key"
        android:title="@string/newpipet_clear_cache_title"
        android:summary="@string/newpipet_clear_cache_summary"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
